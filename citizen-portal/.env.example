VITE_API_URL=http://localhost:5207

# --- E2E test credentials (QA gap #59 — tests/e2e/helpers/auth.ts, opsiyonel) ---
# Verilmezse login gerektiren testler otomatik atlanır (hasCredentials()).
# E2E_TCKN=12345678950
# E2E_PASSWORD=Test1234!
# E2E_OTP_CODE=111111

# --- Production safety guard (QA gap #1 — tests/e2e/helpers/productionSafety.ts) ---
# Yıkıcı (create/update/delete) testler production baseURL'ine karşı otomatik
# bloklanır. Kasıtlı olarak production'a karşı çalıştırmak için:
# E2E_ALLOW_DESTRUCTIVE=1

# --- Test data cleanup (QA gap #10 — tests/e2e/helpers/qaTestData.ts, opsiyonel) ---
# Verilirse QA-TEST-E2E-AUTO- prefix'li test kayıtları temizlenebilir.
# E2E_PG_CONN=postgresql://nexora_admin:PASSWORD@localhost:34100/nexora
# Native uygulama bağlantısı doğrulama dosyaları Docker container başlarken
# bu runtime değerlerinden üretilir. Android değeri Google Play Console'daki
# "Uygulama imzalama anahtarı sertifikası" SHA-256 parmak izidir.
ANDROID_APP_SHA256=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
