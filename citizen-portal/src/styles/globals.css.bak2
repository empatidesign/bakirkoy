@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* ── Tipografi ── */
    --font-sans:    'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-display: 'Poppins', sans-serif;
    --font-mono:    ui-monospace, 'SF Mono', 'Cascadia Code', monospace;

    --text-scale: 1; /* 0.875 = compact | 1 = normal | 1.125 = comfortable */
    --text-xs:   calc(0.6875rem * var(--text-scale));  /* 11px */
    --text-sm:   calc(0.8125rem * var(--text-scale));  /* 13px */
    --text-base: calc(0.9375rem * var(--text-scale));  /* 15px */
    --text-lg:   calc(1.0625rem * var(--text-scale));  /* 17px */
    --text-xl:   calc(1.25rem   * var(--text-scale));  /* 20px */
    --text-2xl:  calc(1.5rem    * var(--text-scale));  /* 24px */
    --text-3xl:  calc(1.875rem  * var(--text-scale));  /* 30px */

    /* ── Renkler ── */
    --background: 0 0% 100%;
    --foreground: 215 18% 30%;

    --card: 0 0% 100%;
    --card-foreground: 215 28% 17%;

    --surface-0: 0 0% 100%;
    --surface-1: 210 20% 98%;
    --surface-2: 210 16% 96%;

    --primary: 214 80% 48%;
    --primary-foreground: 0 0% 100%;
    --primary-soft: 214 64% 95%;

    --secondary: 210 16% 93%;
    --secondary-foreground: 215 28% 17%;

    --success: 160 84% 39%;
    --success-foreground: 0 0% 100%;
    --success-soft: 152 76% 96%;

    --warning: 38 92% 50%;
    --warning-foreground: 0 0% 100%;
    --warning-soft: 48 100% 96%;

    --danger: 0 72% 51%;
    --danger-foreground: 0 0% 100%;
    --danger-soft: 0 86% 97%;

    --info: 199 89% 48%;
    --info-foreground: 0 0% 100%;
    --info-soft: 204 100% 97%;

    --muted: 210 16% 93%;
    --muted-foreground: 215 12% 50%;

    --border: 220 13% 91%;
    --input: 220 13% 91%;
    --ring: 214 80% 48%;

    --foreground-default: 215 18% 30%;
    --foreground-strong: 215 28% 17%;
    --foreground-muted:  215 12% 50%;
    --foreground-subtle: 215 8% 70%;

    --radius-lg: 0.5rem;
    --radius-md: 0.375rem;
    --radius-sm: 0.25rem;

    /* ── Şekil tokenları — tüm tasarım buradan beslenir ── */
    /* field = input/button/select | card = kart/panel | panel = drawer/modal */
    /* Kurumsal his için kontroller hafif köşeli (6px); kartlar 10px */
    --radius-field: 0.375rem; /* 6px  — input/button/select tek kaynak */
    --radius-card:  0.625rem; /* 10px */
    --radius-panel: 0.875rem; /* 14px */
    --radius-pill:  9999px;

    /* Kontrol yüksekliği — TEK KAYNAK. Tüm input/select/combobox/date/time/button(md)
       bu değişkeni kullanır; buradan değiştirince tüm kontroller birlikte değişir. */
    --control-h:    2.5rem;   /* 40px — varsayılan kontrol yüksekliği */
    --control-h-sm: 2.25rem;  /* 36px — kompakt (yoğun matris/araç çubuğu) */

    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.05);

    /* ── Yükseklik (elevation) tokenları ── */
    --shadow-card:  0 1px 2px 0 rgb(0 0 0 / 0.04);
    --shadow-pop:   0 8px 24px -6px rgb(0 0 0 / 0.12), 0 2px 6px -2px rgb(0 0 0 / 0.08);
    --shadow-panel: -12px 0 36px -16px rgb(0 0 0 / 0.22);
    --shadow-modal: 0 24px 56px -16px rgb(0 0 0 / 0.28);
    --shadow-sidebar: 0 4px 11.4px rgb(0 0 0 / 0.25);

    /* ── Marka gradyanı (ikon rozetleri, vurgular) ── */
    --gradient-brand: linear-gradient(135deg, hsl(var(--primary)) 0%, hsl(var(--primary) / 0.72) 100%);

    /* ── Vurgu (accent) tokenları — kurumsal, dingin tonlar (neon değil) ── */
    --accent-blue:   214 76% 47%;  /* kurumsal mavi */
    --accent-green:  162 58% 37%;  /* teal-yeşil, dingin */
    --accent-orange: 30 68% 47%;   /* kehribar/bronz, sıcak ama neon değil */
    --accent-violet: 243 42% 52%;  /* rafine indigo */
    --accent-pink:   330 64% 52%;  /* dingin gül/pembe */
    /* accent soft zeminler (ikon çipleri) — dark'ta .dark bloğunda invert edilir */
    --accent-blue-soft:   214 56% 94%;
    --accent-green-soft:  162 40% 93%;
    --accent-orange-soft: 30 64% 93%;
    --accent-violet-soft: 243 48% 95%;
    --accent-pink-soft:   330 60% 95%;
  }

  * {
    @apply border-border;
    box-sizing: border-box;
  }

  body {
    @apply bg-surface-0 font-sans;
    font-size: var(--text-sm);
    color: hsl(var(--foreground-default));
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  /* ── Dark Mode ─────────────────────────────────────── */
  .dark {
    --background:          222 47% 8%;
    --foreground:          210 20% 98%;
    --card:                222 47% 10%;
    --card-foreground:     210 20% 98%;
    --surface-0:           222 47% 8%;
    --surface-1:           222 47% 11%;
    --surface-2:           222 47% 15%;
    --secondary:           217 33% 20%;
    --secondary-foreground:210 20% 88%;
    --muted:               217 33% 20%;
    --muted-foreground:    215 16% 55%;
    --border:              217 33% 22%;
    --input:               217 33% 22%;
    --foreground-default:  210 20% 88%;
    --foreground-strong:   210 20% 98%;
    --foreground-muted:    215 16% 55%;
    --foreground-subtle:   215 16% 38%;
    --primary-soft:        214 70% 16%;
    --success-soft:        160 60% 10%;
    --warning-soft:        38 70% 12%;
    --danger-soft:         0 60% 12%;
    --info-soft:           199 80% 10%;

    /* Marka / semantik tonlar — koyu zeminde göz yormamak için
       doygunluk hafif düşürülüp parlaklık korunur/artırılır */
    --primary:             214 78% 60%;
    --ring:                214 78% 60%;
    --success:             160 64% 48%;
    --warning:             38 88% 58%;
    --danger:              0 75% 64%;
    --info:                199 80% 60%;

    /* Accent renkleri + soft zeminleri — koyu zemine uyarlanır (dingin kurumsal) */
    --accent-blue:         214 76% 64%;
    --accent-green:        162 52% 52%;
    --accent-orange:       30 70% 58%;
    --accent-violet:       243 56% 68%;
    --accent-pink:         330 68% 66%;
    --accent-blue-soft:    214 48% 18%;
    --accent-green-soft:   162 42% 14%;
    --accent-orange-soft:  30 50% 16%;
    --accent-violet-soft:  243 40% 20%;
    --accent-pink-soft:    330 40% 20%;

    --shadow-card:  0 1px 2px 0 rgb(0 0 0 / 0.4);
    --shadow-pop:   0 8px 24px -6px rgb(0 0 0 / 0.55), 0 2px 6px -2px rgb(0 0 0 / 0.4);
    --shadow-panel: -12px 0 36px -16px rgb(0 0 0 / 0.6);
    --shadow-modal: 0 24px 56px -16px rgb(0 0 0 / 0.7);
    --shadow-sidebar: 0 4px 11.4px rgb(0 0 0 / 0.55);
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-track {
    background: hsl(var(--surface-1));
  }

  ::-webkit-scrollbar-thumb {
    background: hsl(var(--border));
    border-radius: 3px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--foreground-subtle));
  }
}

/* ── Modül tonu — primary'yi danger'a remap eder (acil/afet modülleri) ──
   Bir alt-ağaca (sayfa kökü veya portal yüzeyi) eklenir; içindeki tüm primary
   aksanları (buton, bg-gradient-brand rozet, tab, focus/ring, primary-soft çip)
   otomatik kırmızıya döner. Tek kaynak: yalnız bu değişkenler remap edilir,
   hiçbir bileşen elle renklendirilmez. Light/dark fark etmez (danger token'ı
   temaya göre çözülür). */
.tone-danger {
  --primary: var(--danger);
  --primary-foreground: var(--danger-foreground);
  --primary-soft: var(--danger-soft);
  --ring: var(--danger);
  --gradient-brand: linear-gradient(135deg, hsl(var(--danger)) 0%, hsl(var(--danger) / 0.72) 100%);
}

/*
  TİPOGRAFİ SINIF SİSTEMİ
  ─────────────────────────────────────────────────────────────
  Bileşenlere doğrudan text-xs/sm/... + renk yazmak yasak.
  Bunun yerine bu semantic sınıflar kullanılır.
  Boyut veya renk değiştirmek gerekirse SADECE burası güncellenir
  — her bileşen otomatik değişir.
  ─────────────────────────────────────────────────────────────
*/
@layer components {
  /* ── Marka / Logo ─────────────────────────────────── */
  .type-brand      { @apply text-lg font-normal;          color: hsl(var(--foreground-strong)); }
  .type-brand-sub  { @apply text-sm;                      color: hsl(var(--primary)); }

  /* ── Sayfa Başlıkları ─────────────────────────────── */
  .type-page-title { @apply text-sm font-medium;          color: hsl(var(--foreground-strong)); }
  .type-breadcrumb { @apply text-xs;                      color: hsl(var(--foreground-muted)); }

  /* ── Bölüm / Modal Başlıkları ─────────────────────── */
  .type-section    { @apply text-sm font-medium;          color: hsl(var(--foreground-strong)); }
  .type-section-sub{ @apply text-xs;                      color: hsl(var(--foreground-muted)); }

  /* ── Navigasyon ───────────────────────────────────── */
  .type-nav        { @apply text-xs font-medium;          color: hsl(var(--foreground-strong)); }

  /* ── Gövde Metni ──────────────────────────────────── */
  .type-body       { @apply text-xs;                      color: hsl(var(--foreground-default)); }
  .type-body-strong{ @apply text-xs font-medium;          color: hsl(var(--foreground-strong)); }
  .type-muted      { @apply text-xs;                      color: hsl(var(--foreground-muted)); }
  .type-caption    { font-size: 10px;                     color: hsl(var(--foreground-subtle)); }

  /* ── Form ─────────────────────────────────────────── */
  .type-label      { @apply text-xs font-medium;          color: hsl(var(--foreground-default)); }

  /* ── Kullanıcı Bilgisi ────────────────────────────── */
  .type-user-name  { @apply text-sm font-medium;          color: hsl(var(--foreground-strong)); }
  .type-user-role  { @apply text-xs;                      color: hsl(var(--foreground-muted)); }

  /* ── Header Tarih / Canlı Saat (referans ile aynı) ── */
  .type-clock      { @apply text-sm tabular-nums;         color: hsl(var(--foreground-muted)); }

  /* ── Tablo ────────────────────────────────────────── */
  .type-table-head { @apply text-xs font-medium;          color: hsl(var(--foreground-muted)); }
  .type-table-cell { @apply text-xs;                      color: hsl(var(--foreground-strong)); }

  /* ── KPI / İstatistik ─────────────────────────────── */
  .type-kpi-value  { @apply text-xl font-medium leading-none; color: hsl(var(--foreground-strong)); }
  .type-kpi-label  { @apply text-xs;                      color: hsl(var(--foreground-muted)); }
  .type-stat-value { @apply text-3xl font-bold leading-none tabular-nums; color: hsl(var(--foreground-strong)); }
  .type-stat-label { @apply text-xs font-medium;          color: hsl(var(--foreground-muted)); }

  /* ── Standalone Sayfalar (Auth, Hata, Onboarding) ── */
  .type-heading    { @apply text-2xl font-semibold;       color: hsl(var(--foreground-strong)); }
  .type-heading-sm { @apply text-xl font-semibold;        color: hsl(var(--foreground-strong)); }
  .type-desc       { @apply text-sm;                      color: hsl(var(--foreground-muted)); }
  .type-link       { @apply text-sm font-medium;          color: hsl(var(--primary)); }
  .type-link-sm    { @apply text-xs font-medium;          color: hsl(var(--primary)); }
}

/*
  TOAST (Sonner) — TASARIM TEK KAYNAKTAN
  ─────────────────────────────────────────────────────────────
  Tüm toast görünümü buradan beslenir; token tabanlı + dark-safe.
  Renk/şekil/gölge değişimi için SADECE burası güncellenir.
  ─────────────────────────────────────────────────────────────
*/
[data-sonner-toaster] {
  --normal-bg: hsl(var(--surface-0));
  --normal-border: hsl(var(--border));
  --normal-text: hsl(var(--foreground-default));
  --border-radius: var(--radius-card);
}

[data-sonner-toast] {
  background: hsl(var(--surface-0)) !important;
  color: hsl(var(--foreground-default)) !important;
  border: 1px solid hsl(var(--border)) !important;
  border-left-width: 4px !important;
  border-radius: var(--radius-card) !important;
  box-shadow: var(--shadow-modal) !important;
  padding: 14px 16px !important;
  gap: 12px !important;
  font-family: var(--font-sans) !important;
  align-items: flex-start !important;
}

[data-sonner-toast] [data-title] {
  font-family: var(--font-sans) !important;
  color: hsl(var(--foreground-strong));
  font-weight: 600;
  font-size: var(--text-sm);
  letter-spacing: normal;
  line-height: 1.35;
}

[data-sonner-toast] [data-description] {
  font-family: var(--font-sans) !important;
  color: hsl(var(--foreground-muted));
  font-size: var(--text-xs);
  letter-spacing: normal;
  margin-top: 2px;
}

[data-sonner-toast] [data-icon] {
  width: 20px;
  height: 20px;
  margin-top: 1px;
}

[data-sonner-toast] [data-close-button] {
  background: hsl(var(--surface-0)) !important;
  border: 1px solid hsl(var(--border)) !important;
  color: hsl(var(--foreground-muted)) !important;
  border-radius: var(--radius-field) !important;
}

[data-sonner-toast][data-type='success'] { border-left-color: hsl(var(--success)) !important; }
[data-sonner-toast][data-type='success'] [data-icon] { color: hsl(var(--success)); }
[data-sonner-toast][data-type='error'] { border-left-color: hsl(var(--danger)) !important; }
[data-sonner-toast][data-type='error'] [data-icon] { color: hsl(var(--danger)); }
[data-sonner-toast][data-type='warning'] { border-left-color: hsl(var(--warning)) !important; }
[data-sonner-toast][data-type='warning'] [data-icon] { color: hsl(var(--warning)); }
[data-sonner-toast][data-type='info'] { border-left-color: hsl(var(--info)) !important; }
[data-sonner-toast][data-type='info'] [data-icon] { color: hsl(var(--info)); }

/* ══════════════════════════════════════════════════════════════
   AUTH SAYFASI — mobilfrontendyakup tasarım dili
   Deep navy arka plan + soft-3D kart + mavi-turuncu marka DNA
   ══════════════════════════════════════════════════════════════ */

/* Tam ekran derin lacivert zemin */
.auth-shell {
  position: relative;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 20px;
  overflow: hidden;
  background:
    radial-gradient(900px 600px at 10% -10%, #102f4d 0%, transparent 55%),
    radial-gradient(800px 700px at 105% 15%, #0a2238 0%, transparent 50%),
    linear-gradient(160deg, #0c1f33 0%, #0a1a2c 100%);
  font-family: 'Plus Jakarta Sans', 'Poppins', sans-serif;
}

/* Dekoratif ışık topları */
.auth-bg-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(80px);
  opacity: 0.18;
}
.auth-bg-orb--1 {
  width: 420px; height: 420px;
  background: radial-gradient(circle, #1486C9 0%, transparent 70%);
  top: -120px; right: -80px;
}
.auth-bg-orb--2 {
  width: 320px; height: 320px;
  background: radial-gradient(circle, #F2872E 0%, transparent 70%);
  bottom: -100px; left: -60px;
  opacity: 0.12;
}

/* İnce grid doku */
.auth-bg-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 48px 48px;
}

/* Ortalanmış içerik sütunu */
.auth-center {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

/* Marka alanı */
.auth-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}
.auth-brand__mark {
  width: 52px; height: 52px;
  border-radius: 16px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  display: grid;
  place-items: center;
  backdrop-filter: blur(8px);
  flex: none;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
.auth-brand__mark img {
  width: 36px; height: 36px;
  object-fit: contain;
  filter: brightness(0) invert(1);
}
.auth-brand__text {
  display: flex;
  flex-direction: column;
  line-height: 1;
}
.auth-brand__name {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: #ffffff;
}
.auth-brand__sub {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: #38A6E6;
  margin-top: 3px;
}

/* Ana kart — frosted glass üzerine oturan beyaz yüzey */
.auth-card {
  width: 100%;
  background: rgba(255,255,255,0.96);
  border-radius: 28px;
  border: 1px solid rgba(255,255,255,0.6);
  box-shadow:
    0 32px 80px rgba(12,41,66,0.45),
    0 8px 24px rgba(12,41,66,0.25),
    inset 0 1px 0 rgba(255,255,255,0.9);
  overflow: hidden;
  backdrop-filter: blur(20px);
}

/* Üst dekor şerit */
.auth-card::before {
  content: '';
  display: block;
  height: 4px;
  background: linear-gradient(90deg, #1486C9 0%, #38A6E6 50%, #F2872E 100%);
}

.auth-card__head {
  padding: 24px 28px 0;
  text-align: center;
}
.auth-card__title {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0C2942;
  line-height: 1.1;
}
.auth-card__sub {
  font-size: 13px;
  font-weight: 500;
  color: #6E8092;
  margin-top: 6px;
  line-height: 1.5;
}

.auth-card__body {
  padding: 20px 28px 28px;
}

/* Form elementlerini auth-card içinde özelleştir */
.auth-card__body input {
  font-family: 'Plus Jakarta Sans', 'Poppins', sans-serif !important;
}

/* Button override — turuncu CTA */
.auth-card__body .auth-cta {
  width: 100%;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, #1486C9 0%, #0E66A8 100%);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.01em;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 12px 28px rgba(20,134,201,0.40);
  transition: transform 0.15s cubic-bezier(.32,.72,0,1), box-shadow 0.2s;
  margin-top: 4px;
}
.auth-card__body .auth-cta:hover {
  transform: translateY(-1px);
  box-shadow: 0 18px 36px rgba(20,134,201,0.48);
}
.auth-card__body .auth-cta:active {
  transform: translateY(1px) scale(0.985);
  box-shadow: 0 8px 18px rgba(20,134,201,0.30);
}
.auth-card__body .auth-cta:disabled {
  opacity: 0.7;
  transform: none;
  cursor: not-allowed;
}

/* Footer linkler */
.auth-footer {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.auth-footer p {
  font-size: 12.5px;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
}
.auth-footer a {
  color: #38A6E6;
  font-weight: 700;
  text-decoration: none;
  transition: color 0.15s;
}
.auth-footer a:hover { color: #5bbfef; }

/* Platform yazısı */
.auth-bottom-text {
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.2);
  text-align: center;
}

/* Dark modda auth shell değişmez (kendi renk şemasına sahip) */
.dark .auth-shell {
  background:
    radial-gradient(900px 600px at 10% -10%, #0d2540 0%, transparent 55%),
    radial-gradient(800px 700px at 105% 15%, #081929 0%, transparent 50%),
    linear-gradient(160deg, #091825 0%, #060f18 100%);
}
.dark .auth-card {
  background: rgba(14,26,44,0.95);
  border-color: rgba(255,255,255,0.08);
}
.dark .auth-card__title { color: #e8f0f8; }
.dark .auth-card__sub { color: #8aa0b6; }
