coverage/

# SQL dump (asla commit edilmez) — kişisel veri ve şifre hash'i içerir.
# Kalıplar geniş tutuldu: tarih/isim varyasyonları elden kaçmasın.
*.sql
*.sql.gz
*.dump
*.dump.gz
*.backup
*.pgsql
# Elle yazılan bakım/onarım script'leri veri içermez, commit edilebilir.
!scripts/**/*.sql

# Firebase service account (FCM) — gizli anahtar, asla commit edilmez
service-account.json
**/service-account.json
.worktrees/

# Yerel sır dosyaları — asla commit edilmemeli
.env
.env.local
.env.*.local
